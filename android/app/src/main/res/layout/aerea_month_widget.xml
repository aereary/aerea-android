<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/month_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_cloudberry"
    android:orientation="vertical"
    android:padding="13dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/month_widget_today"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="54dp"
            android:paddingLeft="4dp"
            android:paddingRight="8dp"
            android:text="Hoy"
            android:textColor="#315269"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/month_widget_previous"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_round_button"
            android:gravity="center"
            android:text="‹"
            android:textColor="#315269"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/month_widget_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Julio 2026"
            android:textColor="#273D54"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/month_widget_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_round_button"
            android:gravity="center"
            android:text="›"
            android:textColor="#315269"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/month_widget_add"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/widget_add_button"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="27sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="3dp"
        android:background="#38FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:orientation="horizontal">

        <TextView style="@style/AereaWidgetWeekday" android:text="D" />
        <TextView style="@style/AereaWidgetWeekday" android:text="L" />
        <TextView style="@style/AereaWidgetWeekday" android:text="M" />
        <TextView style="@style/AereaWidgetWeekday" android:text="M" />
        <TextView style="@style/AereaWidgetWeekday" android:text="J" />
        <TextView style="@style/AereaWidgetWeekday" android:text="V" />
        <TextView style="@style/AereaWidgetWeekday" android:text="S" />
    </LinearLayout>

    <GridView
        android:id="@+id/month_widget_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnWidth="40dp"
        android:gravity="center"
        android:horizontalSpacing="2dp"
        android:numColumns="7"
        android:scrollbars="none"
        android:stretchMode="columnWidth"
        android:verticalSpacing="2dp" />

    <TextView
        android:id="@+id/month_widget_selected_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_pill"
        android:paddingLeft="9dp"
        android:paddingTop="3dp"
        android:paddingRight="9dp"
        android:paddingBottom="3dp"
        android:text="HOY"
        android:textColor="#527780"
        android:textSize="9sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/month_widget_event_row_1"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/month_widget_event_time_1"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:textColor="#627589"
            android:textSize="10sp" />

        <View
            android:id="@+id/month_widget_event_bar_1"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_marginRight="9dp"
            android:background="#9FD8EB" />

        <TextView
            android:id="@+id/month_widget_event_title_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/widget_event_placeholder"
            android:textColor="#26384B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/month_widget_event_face_1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_face_bubble"
            android:gravity="center"
            android:text="✦"
            android:textColor="#725E93"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/month_widget_event_row_2"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/month_widget_event_time_2"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:textColor="#627589"
            android:textSize="10sp" />

        <View
            android:id="@+id/month_widget_event_bar_2"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_marginRight="9dp"
            android:background="#B6A0DA" />

        <TextView
            android:id="@+id/month_widget_event_title_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="#26384B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/month_widget_event_face_2"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_face_bubble"
            android:gravity="center"
            android:text="♡"
            android:textColor="#725E93"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
