<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_cloudberry"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_today"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="54dp"
            android:paddingLeft="4dp"
            android:paddingRight="8dp"
            android:text="Hoy"
            android:textColor="#315269"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_previous"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_round_button"
            android:gravity="center"
            android:text="‹"
            android:textColor="#315269"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_date_placeholder"
            android:textColor="#273D54"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_temperature"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="35dp"
            android:text="@string/widget_temperature_placeholder"
            android:textColor="#527780"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_round_button"
            android:gravity="center"
            android:text="›"
            android:textColor="#315269"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/widget_add"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/widget_add_button"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="27sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="#38FFFFFF" />

    <LinearLayout
        android:id="@+id/widget_event_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_event_time_1"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:textColor="#627589"
            android:textSize="11sp" />

        <View
            android:id="@+id/widget_event_bar_1"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_marginRight="10dp"
            android:background="#9FD8EB" />

        <TextView
            android:id="@+id/widget_event_title_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:text="@string/widget_event_placeholder"
            android:textColor="#26384B"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_event_face_1"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_face_bubble"
            android:gravity="center"
            android:text="✦"
            android:textColor="#725E93"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_event_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_event_time_2"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:textColor="#627589"
            android:textSize="11sp" />

        <View
            android:id="@+id/widget_event_bar_2"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_marginRight="10dp"
            android:background="#B6A0DA" />

        <TextView
            android:id="@+id/widget_event_title_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:textColor="#26384B"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_event_face_2"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_face_bubble"
            android:gravity="center"
            android:text="♡"
            android:textColor="#725E93"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/widget_pill"
        android:paddingLeft="10dp"
        android:paddingTop="4dp"
        android:paddingRight="10dp"
        android:paddingBottom="4dp"
        android:text="@string/widget_progress_placeholder"
        android:textColor="#425A43"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
